{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "erp-clave-update",
  "version": "../package.json",
  "identifier": "com.jalm.erp-clave-update",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ERP Clave Update",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCRTE0NUEyNDVFNTU1OEIKUldTTFZlVkZva1hocXpUWWhMeVdnUHR0ZzZjeWNXK0svajFuK1NXOUhVbEl5ak80aUhwajA5YTgK",
      "endpoints": [
        "https://github.com/J4LM/erp-clave-update/releases/latest/download/latest.json"
      ]
    }
  }
}
